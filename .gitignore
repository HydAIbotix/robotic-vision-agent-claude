# ── Secrets ───────────────────────────────────────────────────────────────────
.env
*.env

# ── Python bytecode ───────────────────────────────────────────────────────────
**/__pycache__/
*.py[cod]
*.pyo

# ── Build / distribution ──────────────────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Runtime output (generated at run time, not source) ────────────────────────
screenshots/
camera_captures/
coordinate_exports/
results/
*.log
*.db
test_plans/
app_map.json

# ── Auto-Repair RAG index (Chroma + HuggingFace, generated per-environment) ─────
docs/chroma_code_db/
**/chroma_code_db/

# ── Test artefacts ────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── IDEs ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Screen reference templates (camera-domain, per-environment generated data) ──
# The folder + README stay tracked; the captured PNG templates are per-setup, like app_map.json.
reference_screens/*.png
reference_screens/*.jpg
reference_screens/*.jpeg
reference_screens/*.bmp
reference_screens/*.webp
!reference_screens/README.md
/reference_screens
docs/~$kiosk_e2e_tests.xlsx
docs/~$osk_POS_and_SmartCardStation_Production_Design.docx
