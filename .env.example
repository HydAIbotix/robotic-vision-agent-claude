# ── Vision backend ────────────────────────────────────────────────────────────
# "anthropic" for local/dev   |   "bedrock" for AWS (no other code changes)
VISION_BACKEND=anthropic
ANTHROPIC_API_KEY=your-key-here
# Opus 4.8 — best reasoning for screen analysis, test-plan generation, and Tier-3.
# Tier-1/2 execution uses 0 LLM calls, so steady-state cost is unaffected.
ANTHROPIC_MODEL=claude-opus-4-8
# Model for app-exploration reasoning (defaults to Opus 4.8 if unset).
ANTHROPIC_EXPLORER_MODEL=claude-opus-4-8

# AWS Bedrock — only needed when VISION_BACKEND=bedrock
BEDROCK_REGION=us-east-1
# Bedrock model ID for Claude (check AWS console for latest)
BEDROCK_MODEL_ID=anthropic.claude-opus-4-8

# ── Storage backend ───────────────────────────────────────────────────────────
# "local" (dev) | "s3" (AWS) | "minio" | "gcs" | "azure" — all S3-compatible, endpoint decides.
STORAGE_BACKEND=local
S3_BUCKET=
S3_PREFIX=vision-agent

# SQS image queue (AWS-only Lambda bridge from MSK robot.{id}.image topic; unused off AWS)
SQS_QUEUE_URL=

# ── Agent ─────────────────────────────────────────────────────────────────────
MAX_RETRIES=3
SCREENSHOTS_DIR=./screenshots
RESULTS_DIR=./results

# ══ CLOUD-AGNOSTIC DEPLOYMENT (branch: cloud-agnostic-agent) ═══════════════════
# All default to the pure-local MVP; set them only when deploying to a cloud. See
# docs/CLOUD_AGNOSTIC_DECISION.md and docs/CLOUD_AGNOSTIC_DEPLOY.md.

# --- Persistence (relational metadata) ---
# sqlite (dev) | postgres. DB_URL picks the actual engine.
PERSISTENCE_BACKEND=sqlite
# DB_URL=postgresql+psycopg://kioskqa:kioskqa@postgres:5432/kioskqa

# --- Object store extras (only for minio/gcs/azure/self-hosted S3) ---
# S3_ENDPOINT_URL=http://minio:9000     # blank = real AWS S3
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minioadmin           # blank = default cloud cred chain / IAM role
# S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_PATH_STYLE=true

# --- Event bus (realtime; redis enables multi-replica scale-out) ---
EVENT_BUS_BACKEND=memory                # memory | redis
# REDIS_URL=redis://redis:6379/0

# --- Multi-tenancy ---
MULTI_TENANT_ENABLED=false              # true = pooled multi-customer SaaS
DEFAULT_TENANT_ID=default
# Tenant source: X-Tenant-Id header (default) OR a signed JWT bearer-token claim.
TENANT_JWT_ENABLED=false
# TENANT_JWT_SECRET=change-me           # HS256 shared secret (or PEM public key for RS*)
# TENANT_JWT_ALGORITHMS=HS256
# TENANT_JWT_CLAIM=tenant_id
# TENANT_JWT_AUDIENCE=                  # optional aud to verify
# For CLI batch runs (run_parallel.py / run_tests.py / run_explorer.py) in multi-tenant mode,
# set TENANT_ID=<id> so the process writes under that tenant's namespace.
# TENANT_ID=

# --- Deployment / scaling (informational) ---
DEPLOYMENT_MODE=docker                  # docker | k8s
SERVICE_ROLE=all                        # all | api | worker

# --- Task queue (API↔worker split) ---
TASK_QUEUE_BACKEND=inline               # inline (in-process, MVP) | redis (separate worker)
# TASK_QUEUE_KEY=kioskqa:runs

# --- Orchestration (durable workflow engine) — optional ---
ORCHESTRATOR_BACKEND=inprocess          # inprocess | temporal
# TEMPORAL_HOST=localhost:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=kioskqa

# --- Tracing / observability — optional ---
TRACING_BACKEND=none                    # none | otel | langfuse
# OTEL_EXPORTER_ENDPOINT=http://otel-collector:4317
# OTEL_SERVICE_NAME=kioskqa
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Semantic memory (Explorer screen memory) — optional ---
MEMORY_BACKEND=none                     # none | chroma | pgvector
# MEMORY_COLLECTION=kiosk_memory
# MEMORY_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# MEMORY_PERSIST_DIR=./docs/chroma_memory
# PGVECTOR_URL=                         # blank → derive from DB_URL
