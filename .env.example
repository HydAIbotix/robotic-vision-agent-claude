# ── Vision backend ────────────────────────────────────────────────────────────
# "anthropic" for local/dev   |   "bedrock" for AWS (no other code changes)
VISION_BACKEND=anthropic
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# AWS Bedrock — only needed when VISION_BACKEND=bedrock
BEDROCK_REGION=us-east-1
# Bedrock model ID for Claude (check AWS console for latest)
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20251001-v2:0

# ── Storage backend ───────────────────────────────────────────────────────────
# "local" for dev   |   "s3" for AWS (no other code changes)
STORAGE_BACKEND=local
S3_BUCKET=
S3_PREFIX=vision-agent

# SQS image queue (Lambda bridge from MSK robot.{id}.image topic)
SQS_QUEUE_URL=

# ── Agent ─────────────────────────────────────────────────────────────────────
MAX_RETRIES=3
SCREENSHOTS_DIR=./screenshots
RESULTS_DIR=./results
